
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap');

:root {
  --night: #25132f;
  --plum: #462447;
  --pink: #ffb0d8;
  --rose: #ed82bb;
  --lilac: #c6b2ff;
  --pearl: #fff3fa;
  --muted: #b99bb9;
  --glass: rgba(255,255,255,.13);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  background: var(--night);
}

body {
  color: var(--pearl);
  font-family: 'Nunito', sans-serif;
  overflow-x: hidden;
  background:
    radial-gradient(ellipse at 80% 10%, #754477 0%, transparent 36%),
    radial-gradient(ellipse at 10% 50%, #633c78 0%, transparent 40%),
    linear-gradient(145deg, #21122e, #41213e 50%, #26142f);
}

button, a {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
}

.hidden {
  display: none !important;
}

#loader {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 20px;
  background: #281832;
  transition: opacity .9s ease;
}

.loader-star {
  color: var(--pink);
  font-size: 65px;
  filter: drop-shadow(0 0 22px #ff9bd8);
  animation: starPulse 2s ease-in-out infinite;
}

#loader p {
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 4px;
  color: #e6b9df;
}

@keyframes starPulse {
  50% {
    transform: scale(1.2) rotate(45deg);
    filter: drop-shadow(0 0 35px #ff9bd8);
  }
}

/* INTRO */

#entrance {
  min-height: 100svh;
  position: relative;
  isolation: isolate;
  display: grid;
  place-items: center;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 50%, #754b80 0%, transparent 43%),
    radial-gradient(ellipse at 20% 15%, #a65f91 0%, transparent 42%),
    radial-gradient(ellipse at 85% 85%, #6453a0 0%, transparent 40%),
    linear-gradient(140deg, #24132e, #4b294d 55%, #302044);
}

#entrance::before,
#entrance::after {
  content: "";
  position: absolute;
  width: 75vw;
  height: 75vw;
  border: 1px solid #ffffff19;
  border-radius: 50%;
  box-shadow:
    0 0 80px #ffb0d822,
    inset 0 0 100px #c6b2ff12;
  animation: orbit 30s linear infinite;
  z-index: -1;
}

#entrance::after {
  width: 110vw;
  height: 110vw;
  animation-direction: reverse;
  border-color: #ffb0d812;
}

@keyframes orbit {
  to { transform: rotate(360deg); }
}

.entrance-glow {
  position: absolute;
  width: 60vw;
  height: 60vw;
  max-width: 650px;
  max-height: 650px;
  border-radius: 50%;
  background: radial-gradient(circle, #ffacd74d, #bd91ff19 50%, transparent 72%);
  filter: blur(35px);
  animation: glow 6s ease-in-out infinite alternate;
}

@keyframes glow {
  to {
    transform: scale(1.25);
    opacity: .6;
  }
}

.entrance-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 30px 20px;
}

.eyebrow {
  display: block;
  color: #f1b9df;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 4px;
  text-transform: uppercase;
}

.entrance-content h1 {
  margin-top: 27px;
  font-family: 'Fredoka', sans-serif;
  font-size: clamp(66px, 15vw, 125px);
  line-height: .9;
  letter-spacing: -5px;
  font-weight: 600;
  color: #fff0fa;
  text-shadow:
    0 3px 0 #e78fc2,
    0 8px 0 #ad68a8,
    0 20px 55px #ff91d777;
}

.entrance-content h1 span {
  color: #ffc1e3;
  font-size: .7em;
  vertical-align: top;
}

.entrance-content p {
  margin-top: 28px;
  color: #e9c7e4;
  font-family: 'DM Serif Display', serif;
  font-size: clamp(16px, 3vw, 22px);
  font-style: italic;
  letter-spacing: .3px;
}

#enter-world {
  margin-top: 42px;
  border: 1px solid #ffffff70;
  border-radius: 100px;
  padding: 17px 30px;
  color: #40203e;
  background: linear-gradient(120deg, #ffe5f4, #f5bce0 55%, #dfc8ff);
  box-shadow:
    0 12px 40px #ed8ec455,
    inset 0 2px 4px #ffffff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2px;
  transition: transform .35s, box-shadow .35s;
}

#enter-world:active {
  transform: scale(.94);
}

.entrance-decoration {
  margin-top: 48px;
  color: #ffd1e9;
  font-size: 28px;
  text-shadow: 0 0 25px #ffacd7;
}

/* NAVIGATION */

.topbar {
  position: absolute;
  z-index: 5;
  top: 0;
  left: 0;
  width: 100%;
  height: 84px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #ffffff17;
  background: linear-gradient(#29183266, transparent);
  backdrop-filter: blur(8px);
}

.brand {
  font-family: 'Fredoka', sans-serif;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 1px;
  color: #fff1fa;
}

.brand span {
  color: var(--pink);
}

.topbar-label {
  color: #e4bfdf;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 3px;
}

#sound-toggle {
  width: 42px;
  height: 42px;
  border: 1px solid #ffffff3a;
  border-radius: 50%;
  background: #ffffff12;
  color: #ffe3f4;
  backdrop-filter: blur(15px);
}

/* DREAM ISLAND HERO */

.hero {
  position: relative;
  isolation: isolate;
  min-height: 850px;
  height: 100svh;
  overflow: hidden;
  display: flex;
  align-items: center;
  background:
    radial-gradient(ellipse at 75% 42%, #b48adf45, transparent 40%),
    radial-gradient(ellipse at 15% 80%, #ed91c73b, transparent 50%),
    linear-gradient(145deg, #2b1838, #50305a 55%, #322344);
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(90deg, #281832c9 0%, #28183272 42%, transparent 80%);
}

#scene-wrap {
  position: absolute;
  inset: 0;
  z-index: 0;
}

#dream-scene {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: min(540px, 85%);
  margin-left: 9%;
  pointer-events: none;
}

.hero-copy h2 {
  margin-top: 28px;
  font-family: 'Fredoka', sans-serif;
  font-size: clamp(64px, 10vw, 112px);
  font-weight: 500;
  line-height: .94;
  letter-spacing: -4px;
  color: #fff3fa;
  text-shadow: 0 8px 40px #20102e66;
}

.hero-copy h2 span {
  display: inline-block;
  color: #ffb5dc;
  font-family: 'DM Serif Display', serif;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -2px;
}

.hero-copy p {
  margin-top: 25px;
  max-width: 320px;
  color: #e9cce7;
  font-size: 13px;
  line-height: 1.9;
  letter-spacing: .3px;
}

.main-link {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  margin-top: 34px;
  padding: 17px 25px;
  border: 1px solid #ffffff68;
  border-radius: 100px;
  color: #45223f;
  background: linear-gradient(110deg, #ffe4f4, #e5d1ff);
  box-shadow: 0 12px 40px #e79bce35;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2px;
  pointer-events: auto;
  transition: transform .35s, box-shadow .35s;
}

.main-link:active {
  transform: scale(.95);
}

.scroll-note {
  position: absolute;
  z-index: 3;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  color: #f0cde8;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 3px;
}

/* CAT CLUB */

.content-section {
  position: relative;
  overflow: hidden;
  padding: 135px 7%;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 0%, #89577f 0%, transparent 53%),
    radial-gradient(ellipse at 0% 100%, #5c3b72, transparent 55%),
    linear-gradient(145deg, #35203e, #24142e);
}

.content-section::before {
  content: "✧";
  position: absolute;
  top: 60px;
  right: 9%;
  color: #ffbadf;
  font-size: 48px;
  opacity: .55;
}

.content-section h2,
.profile-section h2 {
  margin-top: 24px;
  font-family: 'Fredoka', sans-serif;
  font-size: clamp(46px, 8vw, 78px);
  line-height: 1;
  font-weight: 500;
  letter-spacing: -2px;
  color: #fff0fa;
}

.content-section h2 span {
  color: var(--pink);
}

.content-section > p {
  margin-top: 18px;
  color: #d9b8d6;
  font-family: 'DM Serif Display', serif;
  font-size: 17px;
  font-style: italic;
}

.cat-collection {
  width: min(1100px, 100%);
  margin: 75px auto 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.cat-card {
  position: relative;
  overflow: hidden;
  min-height: 290px;
  padding: 30px 20px;
  border: 1px solid #ffffff28;
  border-radius: 30px;
  background:
    radial-gradient(circle at 50% 0%, #ffffff25, transparent 55%),
    linear-gradient(145deg, #ffffff19, #ffffff08);
  box-shadow:
    0 22px 60px #170b243d,
    inset 0 1px 1px #ffffff35;
  backdrop-filter: blur(18px);
  transition: transform .4s, border-color .4s;
}

.cat-card:active {
  transform: scale(.97);
}

.cat-card .cat-art {
  min-height: 155px;
  display: grid;
  place-items: center;
  color: #ffd5eb;
  font-family: 'DM Serif Display', serif;
  font-size: 82px;
  text-shadow: 0 0 30px #ffb0d888;
}

.cat-card h3 {
  margin-top: 14px;
  font-family: 'Fredoka', sans-serif;
  font-size: 25px;
  font-weight: 500;
  color: #fff0fa;
}

.cat-card p {
  margin-top: 8px;
  color: #d5b5d4;
  font-size: 11px;
  letter-spacing: .4px;
}

/* ROBLOX PROFILE */

.profile-section {
  position: relative;
  overflow: hidden;
  padding: 145px 20px;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 30%, #a46c9c 0%, transparent 50%),
    linear-gradient(145deg, #382044, #20132e);
}

.profile-section::before,
.profile-section::after {
  content: "✧";
  position: absolute;
  color: #ffc1e3;
  font-size: 70px;
  opacity: .5;
}

.profile-section::before {
  top: 15%;
  left: 12%;
}

.profile-section::after {
  bottom: 15%;
  right: 12%;
}

.profile-section h2 {
  font-size: clamp(45px, 8vw, 85px);
}

.roblox-name {
  margin-top: 28px;
  color: #f1c6e5;
  font-family: 'DM Serif Display', serif;
  font-size: 21px;
  font-style: italic;
}

/* FOOTER */

footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 30px 7%;
  background: #1d1028;
  color: #c4a4c4;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 2px;
}

/* MOBILE */

@media (max-width: 700px) {
  .topbar {
    height: 72px;
    padding: 0 6%;
  }

  .topbar-label {
    font-size: 7px;
    letter-spacing: 1.5px;
  }

  .brand {
    font-size: 16px;
  }

  .hero {
    min-height: 800px;
    height: 100svh;
    align-items: flex-start;
  }

  .hero::after {
    background: linear-gradient(
      180deg,
      #281832bb 0%,
      #28183245 42%,
      #28183255 100%
    );
  }

  .hero-copy {
    width: 90%;
    margin: 145px auto 0;
    text-align: center;
  }

  .hero-copy h2 {
    font-size: clamp(59px, 15vw, 86px);
    letter-spacing: -3px;
  }

  .hero-copy p {
    margin-left: auto;
    margin-right: auto;
    font-size: 12px;
  }

  .hero-copy .eyebrow {
    font-size: 8px;
    letter-spacing: 2.5px;
  }

  .cat-collection {
    grid-template-columns: 1fr;
    max-width: 360px;
    gap: 18px;
  }

  .cat-card {
    min-height: 255px;
  }

  .content-section {
    padding: 105px 7%;
  }

  .content-section > p {
    font-size: 15px;
  }

  .profile-section {
    padding: 110px 20px;
  }

  footer {
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 2;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
.roblox-avatar-frame {
  position: relative;
  width: min(78vw, 380px);
  aspect-ratio: 1;
  margin: 45px auto 20px;
  padding: 12px;
  border-radius: 48% 48% 42% 42%;
  background: linear-gradient(
    145deg,
    #fff8ff,
    #ffb8df,
    #d7c4ff,
    #fff0fa
  );
  box-shadow:
    0 0 35px #ffb5df99,
    0 0 90px #c6a1ff66,
    inset 0 0 15px white;
  animation: avatarFloat 4s ease-in-out infinite;
}

.roblox-avatar-frame::before {
  content: "♡";
  position: absolute;
  top: -35px;
  right: -15px;
  z-index: 2;
  color: #fff0fa;
  font-size: 65px;
  text-shadow: 0 0 20px #ff8acb;
}

.roblox-avatar-frame img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border-radius: inherit;
  background: #f8c9e8;
}

@keyframes avatarFloat {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50% { transform: translateY(-12px) rotate(1deg); }
}
